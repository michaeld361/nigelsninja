# All secrets stay on the server. The app runs without them, using sample listings
# and a local scorer and letter writer. Set the keys to switch on the live pipeline.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Render deploy. The live store is a JSON file on a disk, not the SQL migration.
RENDER_API_KEY=
DATA_DIR=
CRON_SECRET=
ANTHROPIC_API_KEY=
WRITING_MODEL=claude-fable-5-1
SCORING_MODEL=claude-sonnet-5-5
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=bebity/linkedin-jobs-scraper
REED_API_KEY=
RAPIDAPI_KEY=
RESEND_API_KEY=
DIGEST_FROM=
DIGEST_TO=nigel@nigeldown.com
ALERT_TO=mail@michaeldown.co.uk
# Public origin written into sign-in emails. Set this to the tunnel URL when the link must open outside this machine.
APP_URL=http://127.0.0.1:43123
MONTHLY_SPEND_CEILING_USD=120
SESSION_SECRET=
